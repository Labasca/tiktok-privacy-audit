# dependencies (restore with: bun install  OR  npm install)
node_modules/

# runtime output
session.log
audit.json
tags.json
discovery.json
audit.heartbeat
*.log

# per-run capture output. bodies/ holds RAW request payloads, which carry the
# session's auth headers and account state, so this must never be committed.
runs/
bodies/

# raw third-party app-bundle files pulled from the phone (TikTok's own manifests).
# the derived analysis in coverage/ is committed, the raw bundle files are not.
manifests/

# selftest scratch. batch.json is regenerated from the live observe.js on every
# run and is deliberately not committed: a stale copy would keep the driver
# suite green after the hook script had already drifted away from it.
selftest/batch.json

# python
__pycache__/
*.pyc
.venv/

# os
.DS_Store

# assembled run archive (contains raw capture output)
audit-archive/

# poster control-plane secrets and per-arm import measurements
automation/keys/
automation/.cache/

# arm media. drop 01-native / 03-scraped locally; prepare-arms derives the rest.
testfiles/*.mov
testfiles/*.mp4
testfiles/*.jpg
testfiles/*.jpeg
testfiles/*.heic
testfiles/*.png
testfiles/*.tags.json
testfiles/*.ttf

# device pulls: Photos DBs, DCIM copies, personal camera files, screenshots
gallery-id/*.MOV
gallery-id/*.mov
gallery-id/*.mp4
gallery-id/*.jpg
gallery-id/*.png
gallery-id/*.sqlite
gallery-id/*.sqlite-shm
gallery-id/*.sqlite-wal
gallery-id/*.tags.json
gallery-id/photos-db/
gallery-id/photos-db-edit/
gallery-id/photos-db-now/
gallery-id/photos-db-rebuilt/
gallery-id/accounts/
gallery-id/accounts-edit/

# conversation exports from /export
test.txt
*.export.txt

# real captures: personal pixels, home GPS, maker-note UUIDs
testfiles/reference-*
testfiles/image-arms/img-2-camera.*
testfiles/image-arms/img-3-canary.*
testfiles/image-arms-pulled/

# variance corpus: real captures, home GPS, per-shot UUIDs
testfiles/variance/
testfiles/variance-video/
